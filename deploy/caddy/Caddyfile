__SITE_DOMAIN__ {
    encode gzip zstd

    root * /var/www/incubator/dist

    @assets {
        path /assets/* *.js *.css *.png *.jpg *.jpeg *.gif *.svg *.webp *.ico *.woff *.woff2 *.ttf *.map
    }
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # SPA fallback
    try_files {path} /index.html
    file_server
}
