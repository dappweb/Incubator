# ============================================================
# Incubator — Environment Variable Template
# Copy to .env and fill in all required values before running.
# Never commit .env to version control.
# ============================================================

# ─── Deployer / Hardhat ─────────────────────────────────────
# Private key of the deployer wallet (no 0x prefix)
DEPLOYER_PRIVATE_KEY=

# BSC Testnet RPC (default public node shown; replace with private RPC for production)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ─── Deployed Contract Addresses ────────────────────────────
# Token addresses (set after first deploy or when using existing tokens)
USDT_TOKEN_ADDRESS=
ICO_TOKEN_ADDRESS=
LIGHT_TOKEN_ADDRESS=

# UUPS proxy addresses (set after deploy, used by upgrade scripts)
INCUBATOR_CORE_PROXY=
NODE_OTC_MARKET_PROXY=
SWAP_POOL_MANAGER_PROXY=
IDENTITY_NFT_PROXY=

# ─── Pool Recipient Wallets ──────────────────────────────────
# Each pool recipient must be a non-zero address.
# Set to the contract address itself (INCUBATOR_CORE_PROXY) to enable
# on-chain settlement via settleLeaderboard / settleNodeRewards / settleSuperNodeRewards.
POOL_LIQUIDITY_RECIPIENT=
POOL_REFERRAL_RECIPIENT=
POOL_SUPER_NODE_RECIPIENT=
POOL_NODE_RECIPIENT=
POOL_PLATFORM_RECIPIENT=
POOL_LEADERBOARD_RECIPIENT=

# OTC fee receiver wallet
OTC_FEE_RECIPIENT=

# ─── Deploy Script Flags ─────────────────────────────────────
# true = deploy MockUSDT instead of using USDT_TOKEN_ADDRESS
USE_MOCK_USDT=false
# true = seed initial swap pool liquidity after deploy
SEED_SWAP_LIQUIDITY=false

# ─── Frontend (Vite) — must be prefixed with VITE_ ───────────
VITE_USDT_CONTRACT_ADDRESS=
VITE_ICO_TOKEN_ADDRESS=
VITE_LIGHT_TOKEN_ADDRESS=
VITE_CORE_CONTRACT_ADDRESS=
VITE_OTC_CONTRACT_ADDRESS=
VITE_SWAP_POOL_ADDRESS=

# PancakeSwap V2 on BSC Testnet
VITE_PANCAKE_V2_ROUTER_ADDRESS=0x9Ac64Cc6e4415144C455BD8E4837Fea55603e5c3
VITE_PANCAKE_V2_FACTORY_ADDRESS=0xB7926C0430Afb07AA7DEfDE6DA862aE0Bde767bc
# Fee in PPM (parts-per-million); PancakeSwap V2 default = 2500 (0.25%)
VITE_PANCAKE_V2_PRIMARY_FEE_PPM=2500

# Appwrite (public announcement channel only — no business logic)
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_ANNOUNCEMENTS_COLLECTION_ID=
